{
  "name": "dsh-pseudo-vision",
  "version": "0.1.0",
  "description": "Tools and a request-time image→text bridge that lets text-only DSH models \"see\" via OCR, color statistics, pixel scanning, and image metadata. Reifies the pseudo-vision flow surfaced by @YinsenW on 2026-08-20.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "node --test tests/"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vision",
    "ocr",
    "text-only",
    "pseudo-vision",
    "yinsen"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "tesseract.js": "^5.1.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsdown": "^0.6.10",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.7 <0.1.0-rc.9"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "injects": [
      "llm",
      "agent"
    ],
    "external": [
      "tesseract.js",
      "sharp"
    ]
  }
}