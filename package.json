{
  "name": "dsh-pseudo-vision",
  "version": "0.4.0",
  "description": "Adds opt-in image-capable sibling routes for text-only providers and converts image blocks into budgeted, locally enhanced OCR, color-statistics, pixel-scan, and metadata evidence before delegation.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SKILL.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/readme"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --experimental-strip-types --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "prepack": "pnpm build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "vision",
    "multimodal",
    "ocr",
    "text-only",
    "pseudo-vision",
    "yinsen"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "tesseract.js"
    ]
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.8",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.8",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.0-rc.7 || 0.1.0-rc.8",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7 || 0.1.0-rc.8",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}